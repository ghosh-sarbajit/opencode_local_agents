{
  "$schema": "https://opencode.ai/config.json",
  // Each model's limit.context = its launcher's MAXLEN - 8192. opencode
  // requests min(limit.output, 32000) = 32000 completion tokens, fires
  // compaction at context - 32000 prompt tokens, and a send is rejected by
  // vLLM above MAXLEN - 32000; the 8192 gap is the slack for compaction to
  // run, and the compaction call itself (context) fits under MAXLEN.
  //   qwen bf16   MAXLEN 262144 -> context 253952 (compacts at 221952)
  //   qwen mxfp4  MAXLEN  98304 -> context  90112 (compacts at  58112)
  //   gemma bf16  MAXLEN  90112 -> context  81920 (compacts at  49920)
  //   fp8 modes   MAXLEN  74400 -> context  65536 (compacts at  33536)
"compaction": { "auto": true, "prune": true },
  "provider": {
    "qwen-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen3.8-27B (local vLLM)",
      "options": {
        "baseURL": "http://127.0.0.1:42069/v1",
        "apiKey": "EMPTY"
      },
      "models": {
        "qwen3.8-27b-bf16": {
          "name": "Qwen3.8-27B 16-bit (local)",
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          "interleaved": "reasoning",
          "limit": { "context": 253952, "output": 32768 },
          "cost": { "input": 0, "output": 0 }
        },
        "qwen3.8-27b-fp8": {
          "name": "Qwen3.8-27B 8-bit (local)",
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          "interleaved": "reasoning",
          "limit": { "context": 65536, "output": 32768 },
          "cost": { "input": 0, "output": 0 }
        },
        "qwen3.8-27b-mxfp4": {
          "name": "Qwen3.8-27B 4-bit (local)",
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          "interleaved": "reasoning",
          "limit": { "context": 90112, "output": 32768 },
          "cost": { "input": 0, "output": 0 }
        }
      }
    },
    "qwen-distill-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen3.8-27B-Fable-Distill (local vLLM)",
      "options": {
        "baseURL": "http://127.0.0.1:42071/v1",
        "apiKey": "EMPTY"
      },
      "models": {
        "qwen3.8-27b-distill-bf16": {
          "name": "Qwen3.8-27B-Fable-Distill 16-bit (local)",
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          "interleaved": "reasoning",
          "limit": { "context": 253952, "output": 32768 },
          "cost": { "input": 0, "output": 0 }
        },
        "qwen3.8-27b-distill-fp8": {
          "name": "Qwen3.8-27B-Fable-Distill 8-bit (local)",
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          "interleaved": "reasoning",
          "limit": { "context": 65536, "output": 32768 },
          "cost": { "input": 0, "output": 0 }
        },
        "qwen3.8-27b-distill-mxfp4": {
          "name": "Qwen3.8-27B-Fable-Distill 4-bit (local)",
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          "interleaved": "reasoning",
          "limit": { "context": 90112, "output": 32768 },
          "cost": { "input": 0, "output": 0 }
        }
      }
    },
    "gemma-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Gemma-4-31B (local vLLM)",
      "options": {
        "baseURL": "http://127.0.0.1:42070/v1",
        "apiKey": "EMPTY"
      },
      "models": {
        "gemma-4-31b-bf16": {
          "name": "Gemma-4-31B 16-bit (local)",
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          "interleaved": "reasoning",
          "limit": { "context": 81920, "output": 32768 },
          "cost": { "input": 0, "output": 0 }
        },
        "gemma-4-31b-fp8": {
          "name": "Gemma-4-31B 8-bit (local)",
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          "interleaved": "reasoning",
          "limit": { "context": 65536, "output": 32768 },
          "cost": { "input": 0, "output": 0 }
        }
      }
    }
  }
}